{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mate-doc/claims.schema.json",
  "title": "mate-doc claims ledger",
  "type": "object",
  "required": ["claims"],
  "additionalProperties": false,
  "properties": {
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][0-9:.+-]+Z?)?$"
    },
    "capability": {
      "type": "string",
      "pattern": "^(git|gh|snow|http|mcp:[a-z0-9_-]+)$"
    },
    "claim": {
      "type": "object",
      "required": ["id", "claim", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^C[0-9]+$" },
        "claim": { "type": "string", "minLength": 1 },
        "status": { "enum": ["verified", "inferred", "not_verified"] },
        "evidence": { "$ref": "#/$defs/evidence" },
        "verdict": { "enum": ["supports", "overstates", "contradicts", "unrelated"] },
        "checked_by": { "type": "string", "minLength": 1 },
        "checked_at": { "$ref": "#/$defs/isoDate" },
        "ttl_days": { "type": "integer", "minimum": 0 },
        "owner": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not_verified" } } },
          "then": { "required": ["owner"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["verified", "inferred"] } } },
          "then": { "required": ["evidence", "checked_by", "checked_at"] }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "needs"],
      "properties": {
        "kind": { "enum": ["code", "query", "link", "record", "mcp"] },
        "needs": { "$ref": "#/$defs/capability" }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "code" },
            "ref": { "type": "string", "pattern": "^[^@\\s]+@[^:\\s]+:[^:\\s]+:[0-9]+$" },
            "excerpt": { "type": "string", "minLength": 1 },
            "needs": { "enum": ["git", "gh"] }
          },
          "required": ["ref", "excerpt"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "query" },
            "sql": { "type": "string", "minLength": 1 },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "rows": { "type": "integer", "minimum": 0 },
                "value": { "type": ["number", "string"] },
                "tolerance": { "type": "number", "minimum": 0 }
              }
            },
            "needs": { "$ref": "#/$defs/capability" }
          },
          "required": ["sql", "expect"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "link" },
            "url": { "type": "string", "pattern": "^https?://" },
            "excerpt": { "type": "string" },
            "needs": { "enum": ["http", "gh"] }
          },
          "required": ["url"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "record" },
            "ref": { "type": "string", "minLength": 1 },
            "field": { "type": "string", "minLength": 1 },
            "expect": { "type": ["string", "number", "boolean"] },
            "needs": { "$ref": "#/$defs/capability" }
          },
          "required": ["ref", "field", "expect"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "mcp" },
            "source": { "type": "string", "minLength": 1 },
            "excerpt": { "type": "string", "minLength": 1 },
            "needs": { "type": "string", "pattern": "^mcp:[a-z0-9_-]+$" }
          },
          "required": ["source", "excerpt"],
          "additionalProperties": false
        }
      ]
    }
  }
}
