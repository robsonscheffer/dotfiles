{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/post-edit-lint/hook.sh \"$TOOL_INPUT_FILE_PATH\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ruby {{ .chezmoi.homeDir }}/.claude/hooks/approve-safe-commands/hook.rb"
          },
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/enforce-pr-template/hook.sh \"$TOOL_INPUT\""
          },
          {
            "type": "command",
            "command": "python3 {{ .chezmoi.homeDir }}/.claude/hooks/commit-msg-guard/hook.py"
          },
          {
            "type": "command",
            "command": "python3 {{ .chezmoi.homeDir }}/.claude/hooks/push-guard/hook.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/worktree-setup/setup.sh"
          },
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/cmux-session-map.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/cmux-session-map.py"
          }
        ]
      }
    ]
  }
}
